{
  "name": "bun-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:backend": "bun run --watch apps/backend/src/index.ts",
    "dev:frontend": "bun --bun run dev apps/frontend",
    "dev": "concurrently -n backend,frontend \"bun dev:backend\" \"bun dev:frontend\"",
    "db:generate": "cd apps/backend && bunx prisma generate",
    "db:migrate": "cd apps/backend && bunx prisma migrate dev --name init",
    "build": "cd apps/frontend && bun run build"
  },
  "dependencies": {
    "bun": "^1.3.14"
  }
}
